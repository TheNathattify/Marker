<?xml version="1.0" encoding="UTF-8"?>
<interface domain="marker">
  <requires lib="gtk" version="4.0"/>

  <object class="GtkHeaderBar" id="wysiwyg_toolbar">
    <child type="start">
      <object class="GtkBox" id="format">
        <property name="orientation">horizontal</property>
        <style>
          <class name="linked"/>
        </style>
        <child>
          <object class="GtkButton" id="bold_btn">
            <property name="icon-name">format-text-bold-symbolic</property>
            <property name="tooltip-text" translatable="yes">Bold</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="italic_btn">
            <property name="icon-name">format-text-italic-symbolic</property>
            <property name="tooltip-text" translatable="yes">Italic</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="underline_btn">
            <property name="icon-name">format-text-underline-symbolic</property>
            <property name="tooltip-text" translatable="yes">Underline</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="strike_btn">
            <property name="icon-name">format-text-strikethrough-symbolic</property>
            <property name="tooltip-text" translatable="yes">Strikethrough</property>
          </object>
        </child>
      </object>
    </child>
    <child type="start">
      <object class="GtkBox" id="insert">
        <property name="orientation">horizontal</property>
        <style>
          <class name="linked"/>
        </style>
        <child>
          <object class="GtkButton" id="link_btn">
            <property name="icon-name">insert-link-symbolic</property>
            <property name="tooltip-text" translatable="yes">Insert Link</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="image_btn">
            <property name="icon-name">insert-image-symbolic</property>
            <property name="tooltip-text" translatable="yes">Insert Image</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="sketcher_btn">
            <property name="icon-name">insert-object-symbolic</property>
            <property name="tooltip-text" translatable="yes">Sketcher</property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
