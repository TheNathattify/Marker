<?xml version="1.0" encoding="UTF-8"?>
<interface domain="marker">
  <requires lib="gtk" version="4.0"/>

  <object class="GtkPopover" id="text_popover">
    <property name="child">
      <object class="GtkBox">
        <property name="orientation">horizontal</property>
        <property name="spacing">6</property>
        <style>
          <class name="linked"/>
        </style>
        <child>
          <object class="GtkEntry" id="text_entry">
            <property name="hexpand">true</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="add_text_button">
            <property name="icon-name">insert-text-symbolic</property>
            <property name="tooltip-text" translatable="yes">Add Text</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="close_text_button">
            <property name="icon-name">window-close-symbolic</property>
            <property name="tooltip-text" translatable="yes">Close</property>
          </object>
        </child>
      </object>
    </property>
  </object>

  <object class="GtkHeaderBar" id="header_bar">
    <child type="start">
      <object class="GtkBox" id="tool_box">
        <property name="orientation">horizontal</property>
        <style>
          <class name="linked"/>
        </style>
        <child>
          <object class="GtkToggleButton" id="pen_radio_button">
            <property name="icon-name">marker-pen-symbolic</property>
            <property name="tooltip-text" translatable="yes">Pen Tool</property>
            <property name="active">true</property>
          </object>
        </child>
        <child>
          <object class="GtkToggleButton" id="eraser_radio_button">
            <property name="icon-name">marker-eraser-symbolic</property>
            <property name="tooltip-text" translatable="yes">Eraser Tool</property>
            <property name="group">pen_radio_button</property>
          </object>
        </child>
        <child>
          <object class="GtkToggleButton" id="text_radio_button">
            <property name="icon-name">marker-text-symbolic</property>
            <property name="tooltip-text" translatable="yes">Text Insertion Tool</property>
            <property name="group">pen_radio_button</property>
          </object>
        </child>
      </object>
    </child>

    <child type="start">
      <object class="GtkColorButton" id="color_selection_button">
        <property name="tooltip-text" translatable="yes">Color Chooser</property>
        <property name="use-alpha">true</property>
      </object>
    </child>

    <child type="start">
      <object class="GtkBox" id="size_box">
        <property name="orientation">horizontal</property>
        <style>
          <class name="linked"/>
        </style>
        <child>
          <object class="GtkToggleButton" id="small_radio_button">
            <property name="icon-name">marker-small-symbolic</property>
            <property name="tooltip-text" translatable="yes">Small</property>
          </object>
        </child>
        <child>
          <object class="GtkToggleButton" id="medium_radio_button">
            <property name="icon-name">marker-medium-symbolic</property>
            <property name="tooltip-text" translatable="yes">Medium</property>
            <property name="active">true</property>
            <property name="group">small_radio_button</property>
          </object>
        </child>
        <child>
          <object class="GtkToggleButton" id="large_radio_button">
            <property name="icon-name">marker-large-symbolic</property>
            <property name="tooltip-text" translatable="yes">Large</property>
            <property name="group">small_radio_button</property>
          </object>
        </child>
      </object>
    </child>

    <child type="end">
      <object class="GtkBox" id="action_box">
        <property name="orientation">horizontal</property>
        <style>
          <class name="linked"/>
        </style>
        <child>
          <object class="GtkButton" id="insert_button">
            <property name="icon-name">insert-image-symbolic</property>
            <property name="tooltip-text" translatable="yes">Insert Sketch</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="close_button">
            <property name="icon-name">window-close-symbolic</property>
            <property name="tooltip-text" translatable="yes">Cancel</property>
          </object>
        </child>
      </object>
    </child>
  </object>

  <object class="GtkBox" id="vbox">
    <property name="orientation">vertical</property>
    <property name="hexpand">true</property>
    <property name="vexpand">true</property>
  </object>
</interface>
