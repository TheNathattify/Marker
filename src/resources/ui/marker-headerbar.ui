<?xml version="1.0" encoding="UTF-8"?>
<interface domain="marker">
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>

  <menu id="view_mode_menu">
    <section>
      <item>
        <attribute name="label" translatable="yes">Editor Only</attribute>
        <attribute name="action">win.editoronlymode</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Preview Only</attribute>
        <attribute name="action">win.previewonlymode</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Dual Pane</attribute>
        <attribute name="action">win.dualpanemode</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Dual Window</attribute>
        <attribute name="action">win.dualwindowmode</attribute>
      </item>
    </section>
  </menu>

  <object class="AdwHeaderBar" id="header_bar">
    <property name="title-widget">
      <object class="AdwWindowTitle" id="window_title">
        <property name="title" translatable="yes">Marker</property>
      </object>
    </property>

    <!-- Start (left) items -->
    <child type="start">
      <object class="GtkButton" id="open_btn">
        <property name="label" translatable="yes">Open…</property>
        <property name="tooltip-text" translatable="yes">Open Document</property>
        <property name="action-name">win.open</property>
      </object>
    </child>
    <child type="start">
      <object class="GtkButton" id="save_btn">
        <property name="label" translatable="yes">Save</property>
        <property name="tooltip-text" translatable="yes">Save Document</property>
        <property name="action-name">win.save</property>
      </object>
    </child>
    <child type="start">
      <object class="GtkButton" id="new_editor_btn">
        <property name="icon-name">tab-new-symbolic</property>
        <property name="tooltip-text" translatable="yes">New Document</property>
        <property name="action-name">win.neweditor</property>
      </object>
    </child>

    <!-- End (right) items -->
    <child type="end">
      <object class="GtkMenuButton" id="menu_btn">
        <property name="icon-name">open-menu-symbolic</property>
        <property name="tooltip-text" translatable="yes">Main Menu</property>
        <property name="menu-model">primary_menu</property>
      </object>
    </child>
    <child type="end">
      <object class="GtkButton" id="unfullscreen_btn">
        <property name="visible">false</property>
        <property name="icon-name">view-restore-symbolic</property>
        <property name="tooltip-text" translatable="yes">Leave Fullscreen</property>
      </object>
    </child>
    <child type="end">
      <object class="GtkMenuButton" id="view_mode_btn">
        <property name="icon-name">view-grid-symbolic</property>
        <property name="tooltip-text" translatable="yes">View Mode</property>
        <property name="menu-model">view_mode_menu</property>
      </object>
    </child>
  </object>
</interface>
