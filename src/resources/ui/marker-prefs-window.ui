<?xml version="1.0" encoding="UTF-8"?>
<interface domain="marker">
  <object class="AdwPreferencesWindow" id="prefs_win">
    <property name="title" translatable="yes">Preferences</property>
    <property name="modal">True</property>
    <property name="destroy_with_parent">True</property>
    <child>
      <object class="AdwPreferencesPage" id="editor_page">
        <property name="title" translatable="yes">Editor</property>
        <property name="icon_name">accessories-text-editor-symbolic</property>
        <child>
          <object class="AdwPreferencesGroup" id="appearance_group">
            <property name="title" translatable="yes">Appearance</property>
            <child>
              <object class="AdwSwitchRow" id="show_line_numbers_row">
                <property name="title" translatable="yes">Show line numbers</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="highlight_current_line_row">
                <property name="title" translatable="yes">Highlight current line</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="wrap_text_row">
                <property name="title" translatable="yes">Wrap text</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="show_spaces_row">
                <property name="title" translatable="yes">Show spaces</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="show_right_margin_row">
                <property name="title" translatable="yes">Show right margin</property>
              </object>
            </child>
            <child>
              <object class="AdwSpinRow" id="right_margin_position_row">
                <property name="title" translatable="yes">Right margin column</property>
                <property name="adjustment">
                  <object class="GtkAdjustment">
                    <property name="lower">1</property>
                    <property name="upper">1000</property>
                    <property name="step_increment">1</property>
                    <property name="page_increment">10</property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="syntax_highlight_row">
                <property name="title" translatable="yes">Syntax highlighting</property>
              </object>
            </child>
            <child>
              <object class="AdwComboRow" id="syntax_theme_row">
                <property name="title" translatable="yes">Syntax theme</property>
              </object>
            </child>
            <child>
              <object class="AdwSpinRow" id="editor_font_size_row">
                <property name="title" translatable="yes">Font size</property>
                <property name="subtitle" translatable="yes">Base font size in points (combined with zoom)</property>
                <property name="adjustment">
                  <object class="GtkAdjustment">
                    <property name="lower">6</property>
                    <property name="upper">36</property>
                    <property name="step_increment">1</property>
                    <property name="page_increment">2</property>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup" id="indentation_group">
            <property name="title" translatable="yes">Indentation</property>
            <child>
              <object class="AdwSwitchRow" id="auto_indent_row">
                <property name="title" translatable="yes">Automatic indentation</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="replace_tabs_row">
                <property name="title" translatable="yes">Insert spaces instead of tabs</property>
              </object>
            </child>
            <child>
              <object class="AdwSpinRow" id="tab_width_row">
                <property name="title" translatable="yes">Tab width</property>
                <property name="adjustment">
                  <object class="GtkAdjustment">
                    <property name="lower">1</property>
                    <property name="upper">12</property>
                    <property name="step_increment">1</property>
                    <property name="page_increment">1</property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="trim_trailing_whitespace_row">
                <property name="title" translatable="yes">Trim trailing whitespace on save</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup" id="spelling_group">
            <property name="title" translatable="yes">Spelling</property>
            <child>
              <object class="AdwSwitchRow" id="spell_check_row">
                <property name="title" translatable="yes">Check spelling</property>
              </object>
            </child>
            <child>
              <object class="AdwComboRow" id="spell_lang_row">
                <property name="title" translatable="yes">Language</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwPreferencesPage" id="preview_page">
        <property name="title" translatable="yes">Preview</property>
        <property name="icon_name">view-reveal-symbolic</property>
        <child>
          <object class="AdwPreferencesGroup" id="styling_group">
            <property name="title" translatable="yes">Styling</property>
            <child>
              <object class="AdwSwitchRow" id="css_theme_toggle_row">
                <property name="title" translatable="yes">Custom CSS stylesheet</property>
              </object>
            </child>
            <child>
              <object class="AdwComboRow" id="css_theme_row">
                <property name="title" translatable="yes">CSS stylesheet</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="code_highlight_row">
                <property name="title" translatable="yes">Code block syntax highlighting</property>
              </object>
            </child>
            <child>
              <object class="AdwComboRow" id="code_highlight_theme_row">
                <property name="title" translatable="yes">Code highlighting theme</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup" id="extensions_group">
            <property name="title" translatable="yes">Extensions</property>
            <child>
              <object class="AdwSwitchRow" id="mathjs_row">
                <property name="title" translatable="yes">Render math expressions</property>
              </object>
            </child>
            <child>
              <object class="AdwComboRow" id="math_backend_row">
                <property name="title" translatable="yes">Math rendering backend</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="mermaid_row">
                <property name="title" translatable="yes">Mermaid diagrams</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="charter_row">
                <property name="title" translatable="yes">Charter charts</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwPreferencesPage" id="window_page">
        <property name="title" translatable="yes">Window</property>
        <property name="icon_name">preferences-system-symbolic</property>
        <child>
          <object class="AdwPreferencesGroup" id="general_group">
            <property name="title" translatable="yes">General</property>
            <child>
              <object class="AdwComboRow" id="view_mode_row">
                <property name="title" translatable="yes">Default view mode</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="dark_mode_row">
                <property name="title" translatable="yes">Dark mode</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
